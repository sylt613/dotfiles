// Drop this into <your-repo>/.devcontainer/devcontainer.json to make every
// codespace on that repo set itself up COMPLETELY — extensions installed by
// GitHub itself, plus Claude login / auto-mode / keep-alive via the dotfiles
// bootstrap below. This works even if "Automatically install dotfiles" is
// NOT enabled in your account settings.
//
// Optionally enable prebuilds afterwards: repo → Settings → Codespaces →
// "Set up prebuild". NOTE: never put tokens/secrets in here or in
// onCreateCommand — prebuild snapshots are stored and shared. Secrets are
// only available at postCreateCommand time.
{
    "name": "ai-dev",
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "github.vscode-pull-request-github",
                "ms-python.python",
                "wienans.opencode-zen-chat-provider",
                "calgan.oai-provider"
            ]
        }
    },
    // Prebuild-time (no user secrets here — by design).
    "onCreateCommand": "npm install -g @anthropic-ai/claude-code || true",
    // Create-time, user secrets present: full dotfiles bootstrap (login,
    // bypassPermissions mode, keep-alive, ai-check). Cloned into $HOME so the
    // self-heal hook survives codespace stop/start.
    "postCreateCommand": "git clone --depth 1 https://github.com/sylt613/dotfiles \"$HOME/.ai-dotfiles\" 2>/dev/null || git -C \"$HOME/.ai-dotfiles\" pull -q || true; bash \"$HOME/.ai-dotfiles/install.sh\" || true",
    // Start-time — runs on EVERY start, including the resume after an idle
    // stop or a reboot. postCreateCommand does NOT re-run then, and the
    // .bashrc self-heal only fires once a human opens a terminal, so without
    // this the keep-alive stays dead exactly when it is needed. The script is
    // a flock singleton and logs to ~/.cs-keepalive.log; `|| true` so a broken
    // keep-alive can never block the codespace from starting.
    // Tries the template clone first, then the account-level dotfiles path
    // ($AI_DOTFILES_DIR, set when "Automatically install dotfiles" is on).
    "postStartCommand": "for d in \"$HOME/.ai-dotfiles\" \"$AI_DOTFILES_DIR\" /workspaces/.codespaces/.persistedshare/dotfiles; do if [ -f \"$d/cs_keepalive.sh\" ]; then nohup bash \"$d/cs_keepalive.sh\" >/dev/null 2>&1 & break; fi; done; true"
}
